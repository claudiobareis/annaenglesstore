{% comment %}
  Mini Cart Customizado (gaveta lateral)
  Conteúdo renderizado por assets/mini-cart.js a partir de /cart.js
  Estilos em assets/push.css (bloco "Mini cart")
{% endcomment %}

<script src="{{ 'mini-cart.js' | asset_url }}" defer="defer"></script>

<div
  id="mini-cart"
  class="mini-cart"
  style="display: none;"
  data-currency="{{ cart.currency.iso_code }}"
  data-locale="{{ request.locale.iso_code }}"
  data-text-remove="{{ 'sections.cart.remove_title' | t: title: '[title]' | escape }}"
  data-text-decrease="{{ 'products.product.quantity.decrease' | t: product: '[title]' | escape }}"
  data-text-increase="{{ 'products.product.quantity.increase' | t: product: '[title]' | escape }}"
  data-text-error="{{ 'sections.cart.cart_error' | t | escape }}"
>
  <div class="mini-cart__overlay" data-mini-cart-close></div>
  <div
    class="mini-cart__content color-{{ settings.cart_color_scheme }} gradient"
    role="dialog"
    aria-modal="true"
    aria-labelledby="MiniCartTitle"
    tabindex="-1"
  >
    <div class="mini-cart__header">
      <h2 id="MiniCartTitle" class="mini-cart__title">
        {{ 'sections.cart.title' | t }}
        <span id="mini-cart-count" class="mini-cart__count">
          {%- if cart.item_count > 0 -%}({{ cart.item_count }}){%- endif -%}
        </span>
      </h2>
      <button type="button" class="mini-cart__close" data-mini-cart-close aria-label="{{ 'accessibility.close' | t }}">
        <span class="svg-wrapper">
          {{- 'icon-close.svg' | inline_asset_content -}}
        </span>
      </button>
    </div>

    <div class="mini-cart__body">
      <p id="mini-cart-error" class="mini-cart__error" role="alert" hidden></p>
      <div id="mini-cart-items" class="mini-cart__items" aria-live="polite"></div>
    </div>

    <div id="mini-cart-footer" class="mini-cart__footer"{% if cart == empty %} hidden{% endif %}>
      <div class="mini-cart__total">
        <span class="mini-cart__total-label">{{ 'sections.cart.estimated_total' | t }}</span>
        <span id="mini-cart-total" class="mini-cart__total-value">{{ cart.total_price | money }}</span>
      </div>
      <p class="mini-cart__tax-note">
        {%- if cart.taxes_included -%}
          {{ 'sections.cart.taxes_included_shipping_at_checkout_without_policy' | t }}
        {%- else -%}
          {{ 'sections.cart.taxes_at_checkout_shipping_at_checkout_without_policy' | t }}
        {%- endif -%}
      </p>

      <div class="mini-cart__actions">
        <form action="{{ routes.cart_url }}" method="post">
          <button type="submit" name="checkout" class="button button--primary button--full-width mini-cart__checkout">
            {{ 'sections.cart.checkout' | t }}
          </button>
        </form>
        <a href="{{ routes.cart_url }}" class="mini-cart__view-cart">
          {{ 'general.cart.view_empty_cart' | t }}
        </a>
      </div>
    </div>
  </div>

  <template id="mini-cart-empty-template">
    <div class="mini-cart__empty">
      <span class="mini-cart__empty-icon svg-wrapper">
        {{- 'icon-cart-empty.svg' | inline_asset_content -}}
      </span>
      <p class="mini-cart__empty-text">{{ 'sections.cart.empty' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="button button--secondary mini-cart__empty-button">
        {{ 'general.continue_shopping' | t }}
      </a>
    </div>
  </template>
  <template id="mini-cart-icon-remove">{{ 'icon-remove.svg' | inline_asset_content }}</template>
  <template id="mini-cart-icon-minus">{{ 'icon-minus.svg' | inline_asset_content }}</template>
  <template id="mini-cart-icon-plus">{{ 'icon-plus.svg' | inline_asset_content }}</template>
</div>


